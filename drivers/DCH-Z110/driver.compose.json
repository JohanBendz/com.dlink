{
  "id": "DCH-Z110",
  "name": {
    "en": "Door/Window sensor - DCH-Z110"
  },
  "class": "sensor",
  "platforms": ["local"],
	"connectivity": ["zwave"],
  "capabilities": [
    "alarm_battery",
    "alarm_contact",
    "alarm_tamper",
    "measure_battery",
    "measure_luminance",
    "measure_temperature"
  ],
  "energy": {
    "batteries": [
      "CR123A"
    ]
  },
  "images": {
    "large": "{{driverAssetsPath}}/images/large.png",
    "small": "{{driverAssetsPath}}/images/small.png"
  },
  "zwave": {
    "manufacturerId": 264,
    "productTypeId": [
      2
    ],
    "productId": [
      14
    ],
    "wakeUpInterval": 43200,
    "learnmode": {
      "instruction": {
        "en": "Press any of the tamper buttons (front or back) of the sensor three times to include the device"
      }
    },
    "associationGroups": [
      1
    ],
    "associationGroupsOptions": {
      "1": {
        "hint": {
          "en": "The sensor will send notification report and battery report to the associated nodes. (Z-wave lifeline)"
        }
      }
    },
    "zwaveAllianceProductId": 1151,
    "zwaveAllianceProductDocumentation": "https://products.z-wavealliance.org/products/1151",
    "defaultConfiguration": [
      {
        "id": 5,
        "size": 1,
        "value": 8
      },
      {
        "id": 6,
        "size": 1,
        "value": 4
      },
      {
        "id": 7,
        "size": 1,
        "value": 54
      },
      {
        "id": 22,
        "size": 1,
        "value": 1
      }
    ]
  }
}